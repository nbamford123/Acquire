# Copy to service/.env for local development; README.md lists every setting.
# Production sets these in the Deno Deploy dashboard instead.

# Signs login tokens. Any long random string; required in production
JWT_SECRET="change-me"
# Who can log in, as name:email pairs separated by commas
ALLOWED_EMAILS="Test:test@localhost.com"
# Where Deno KV keeps games; leave unset for Deno's default location
KV_PATH="./.data/acquire.kv"
# Wipe KV and load the games in __test-data__ on each start
SEED_TEST_GAMES="true"
# Reload open pages after a client rebuild or a service restart
DEV_RELOAD="true"
# Keep recent API requests and responses at /dev/requests, and log changes and failures
API_LOG="true"
