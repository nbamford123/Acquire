{
  "version": "1.0.0",
  "workspace": ["./engine", "./service", "./client"],
  "tasks": {
    "build": "deno task --cwd client build",
    "dev": "deno task build --dev && cd service && deno run -A --env-file --unstable-kv --watch main.ts",
    "fmt:check": "deno fmt --check",
    "check": "deno fmt --check && deno lint && deno check && KV_PATH=:memory: deno test --no-check --allow-all",
    "hooks": "git config core.hooksPath .githooks",
    "validate": "deno fmt && deno lint && deno check && KV_PATH=:memory: deno test --no-check --allow-all"
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"],
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/expect": "jsr:@std/expect@1.0.20",
    "@acquire/engine/core": "./engine/core/index.ts",
    "@acquire/engine/types": "./engine/types/index.ts",
    "@acquire/engine/utils": "./engine/utils/index.ts",
    "hono": "jsr:@hono/hono@^4.13.9",
    "hono/cookie": "jsr:@hono/hono@^4.13.9/cookie.ts"
  },

  "lint": {
    "include": ["./"],
    "exclude": ["**/node_modules/", "**/__test__/", "**/dist/"],
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars"]
    }
  },
  "fmt": {
    "include": ["./"],
    "exclude": ["**/node_modules/", "**/dist/", "**/__test__/"],
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "useTabs": false
  },
  "unstable": ["kv", "cron"],
  "deploy": {
    "install": "deno install",
    "build": "deno task build",
    "runtime": {
      "entrypoint": "./service/main.ts"
    }
  }
}
